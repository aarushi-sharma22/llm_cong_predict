#!/bin/sh
# Refuse commits that stage restricted or participant-level data.
# Enable once per clone, from the project directory:
#   git config core.hooksPath "$(git rev-parse --show-prefix)scripts/hooks"
# The project directory is this hook's grandparent, so the hook works whether the
# project is the repository root or a subfolder of a host repository.
project_dir="$(cd "$(dirname "$0")/../.." && pwd)" || exit 1
if [ -x "$project_dir/.venv/bin/python" ]; then
    py="$project_dir/.venv/bin/python"
else
    py="$(command -v python3)" || { echo "pre-commit: python3 not found" >&2; exit 1; }
fi
exec "$py" "$project_dir/scripts/check_no_restricted_data.py"
